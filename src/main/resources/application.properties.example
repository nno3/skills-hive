spring.application.name=GroupProject60
spring.datasource.url=jdbc:mysql://localhost:3306/co2302db
spring.datasource.username=your-mysql-user
spring.datasource.password=your-mysql-password
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.jpa.database-platform=org.hibernate.dialect.MySQL8Dialect
spring.thymeleaf.prefix=classpath:/templates/
spring.thymeleaf.suffix=.html
spring.thymeleaf.cache=false
spring.main.allow-circular-references=true
server.port=8080

watson.assistant.api.key=your-watson-api-key
watson.assistant.url=https://api.eu-gb.assistant.watson.cloud.ibm.com/instances/your-instance
watson.assistant.assistant.id=your-assistant-id
